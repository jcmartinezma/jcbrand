{
  "name": "@jcmartinezma/jcbrand",
  "version": "0.1.0",
  "private": true,
  "description": "Tokens y fuentes de la marca de JC. Se usa como skill de Cursor; no se publica.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jcmartinezma/jcbrand.git"
  },
  "scripts": {
