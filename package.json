{
  "name": "@jcmartinezma/jcbrand",
  "version": "0.2.0",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/jcmartinezma/jcbrand.git"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./fonts.css": "./fonts/fonts.css",
    "./fonts/*": "./fonts/*",
    "./dist/css/tokens.css": "./dist/css/tokens.css",
    "./dist/css/*": "./dist/css/*",
    "./dist/scss": "./dist/scss/_index.scss",
    "./dist/scss/core": "./dist/scss/core/_index.scss",
    "./dist/scss/semantic": "./dist/scss/semantic/_index.scss",
    "./dist/scss/*": "./dist/scss/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check:tokens": "node scripts/check-tokens.mjs",
    "build:tokens": "style-dictionary build --config sd.config.mjs && node scripts/verify-build.mjs",
    "clean:tokens": "style-dictionary clean --config sd.config.mjs",
    "prestorybook": "npm run build:tokens",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run build:tokens",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.6.3",
    "style-dictionary": "^5.7.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
