{
  "name": "@jcmartinezma/jcbrand",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jcmartinezma/jcbrand.git"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    "./fonts.css": "./fonts/fonts.css",
    "./fonts/*": "./fonts/*",
    "./dist/css/tokens.css": "./dist/css/tokens.css",
    "./dist/css/*": "./dist/css/*",
    "./dist/scss": "./dist/scss/_index.scss",
    "./dist/scss/core": "./dist/scss/core/_index.scss",
    "./dist/scss/semantic": "./dist/scss/semantic/_index.scss",
    "./dist/scss/*": "./dist/scss/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check:tokens": "node scripts/check-tokens.mjs",
    "build:tokens": "style-dictionary build --config sd.config.mjs && node scripts/verify-build.mjs",
    "clean:tokens": "style-dictionary clean --config sd.config.mjs"
  },
  "devDependencies": {
    "style-dictionary": "^5.7.0"
  }
}
