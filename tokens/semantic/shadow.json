{
  "$description": "Semantic tokens converted 1:1 from _shadow.semantic.scss.",
  "$extensions": {
    "com.jcbrand": {
      "source": "semantic/_shadow.semantic.scss",
      "selector": ":root"
    }
  },
  "shadow": {
    "xs": {
      "$type": "shadow",
      "$value": {
        "color": "rgb(0 0 0 / 0.16)",
        "offsetX": "0",
        "offsetY": "1px",
        "blur": "2px"
      },
      "$extensions": {
        "com.jcbrand": {
          "cssVar": "--shadow-xs"
        }
      }
    },
    "sm": {
      "$type": "shadow",
      "$value": [
        {
          "color": "rgb(0 0 0 / 0.16)",
          "offsetX": "0",
          "offsetY": "2px",
          "blur": "4px"
        },
        {
          "color": "rgb(0 0 0 / 0.12)",
          "offsetX": "0",
          "offsetY": "1px",
          "blur": "2px"
        }
      ],
      "$extensions": {
        "com.jcbrand": {
          "cssVar": "--shadow-sm"
        }
      }
    },
    "md": {
      "$type": "shadow",
      "$value": [
        {
          "color": "rgb(0 0 0 / 0.18)",
          "offsetX": "0",
          "offsetY": "6px",
          "blur": "12px"
        },
        {
          "color": "rgb(0 0 0 / 0.12)",
          "offsetX": "0",
          "offsetY": "2px",
          "blur": "4px"
        }
      ],
      "$extensions": {
        "com.jcbrand": {
          "cssVar": "--shadow-md"
        }
      }
    },
    "lg": {
      "$type": "shadow",
      "$value": [
        {
          "color": "rgb(0 0 0 / 0.2)",
          "offsetX": "0",
          "offsetY": "12px",
          "blur": "24px"
        },
        {
          "color": "rgb(0 0 0 / 0.12)",
          "offsetX": "0",
          "offsetY": "4px",
          "blur": "8px"
        }
      ],
      "$extensions": {
        "com.jcbrand": {
          "cssVar": "--shadow-lg"
        }
      }
    },
    "xl": {
      "$type": "shadow",
      "$value": [
        {
          "color": "rgb(0 0 0 / 0.22)",
          "offsetX": "0",
          "offsetY": "24px",
          "blur": "48px"
        },
        {
          "color": "rgb(0 0 0 / 0.14)",
          "offsetX": "0",
          "offsetY": "8px",
          "blur": "16px"
        }
      ],
      "$extensions": {
        "com.jcbrand": {
          "cssVar": "--shadow-xl"
        }
      }
    }
  }
}
