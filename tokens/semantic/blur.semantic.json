{
  "$schema": "../../schemas/dtcg-format.2025.10.json",
  "blur": {
    "$description": "Semantic blur scale. Each token aliases a core blur step",
    "$type": "dimension",
    "xs": { "$value": "{blur.100}" },
    "sm": { "$value": "{blur.200}" },
    "md": { "$value": "{blur.300}" },
