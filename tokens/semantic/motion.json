{
  "$description": "Semantic tokens converted 1:1 from _motion.semantic.scss.",
  "$extensions": {
    "com.jcbrand": {
      "source": "semantic/_motion.semantic.scss",
      "selector": ":root"
    }
  },
  "motion": {
    "duration": {
      "instant": {
        "$type": "duration",
        "$value": "{motion.duration.0}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--motion-duration-instant"
          }
        }
      },
      "fast": {
        "$type": "duration",
        "$value": "{motion.duration.100}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--motion-duration-fast"
          }
        }
      },
      "exit": {
        "$type": "duration",
        "$value": "{motion.duration.200}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--motion-duration-exit"
          }
        }
      },
      "normal": {
        "$type": "duration",
        "$value": "{motion.duration.300}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--motion-duration-normal"
          }
        }
      },
      "enter": {
        "$type": "duration",
        "$value": "{motion.duration.400}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--motion-duration-enter"
          }
        }
      },
      "slow": {
        "$type": "duration",
        "$value": "{motion.duration.500}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--motion-duration-slow"
          }
        }
      },
      "emphasis": {
        "$type": "duration",
        "$value": "{motion.duration.600}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--motion-duration-emphasis"
          }
        }
      }
    },
    "delay": {
      "none": {
        "$type": "duration",
        "$value": "{motion.delay.0}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--motion-delay-none"
          }
        }
      },
      "stagger": {
        "$type": "duration",
        "$value": "{motion.delay.100}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--motion-delay-stagger"
          }
        }
      },
      "deferred": {
        "$type": "duration",
        "$value": "{motion.delay.300}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--motion-delay-deferred"
          }
        }
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": "{motion.easing.100}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--motion-easing-standard"
          }
        }
      },
      "enter": {
        "$type": "cubicBezier",
        "$value": "{motion.easing.200}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--motion-easing-enter"
          }
        }
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": "{motion.easing.300}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--motion-easing-exit"
          }
        }
      },
      "linear": {
        "$type": "cubicBezier",
        "$value": "{motion.easing.0}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--motion-easing-linear"
          }
        }
      }
    }
  }
}
