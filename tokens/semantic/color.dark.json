            "cssVar": "--color-text-danger"
          }
        }
      }
    },
    "icon": {
      "primary": {
        "$type": "color",
        "$value": "{color.gray.200}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--color-icon-primary"
          }
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.gray.400}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--color-icon-secondary"
          }
        }
      },
      "tertiary": {
        "$type": "color",
        "$value": "{color.gray.500}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--color-icon-tertiary"
          }
        }
      },
      "accent": {
        "$type": "color",
        "$value": "{color.green.400}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--color-icon-accent"
          }
        }
      }
    },
    "border": {
      "primary": {
        "$type": "color",
        "$value": "{color.gray.100}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--color-border-primary"
          }
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.gray.600}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--color-border-secondary"
          }
        }
      },
      "tertiary": {
        "$type": "color",
        "$value": "{color.gray.700}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--color-border-tertiary"
          }
        }
      },
      "secondary-hover": {
        "$type": "color",
        "$value": "{color.gray.300}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--color-border-secondary-hover"
          }
        }
      },
      "accent": {
        "$type": "color",
        "$value": "{color.green.600}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--color-border-accent"
          }
        }
