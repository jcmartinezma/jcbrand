{
  "$description": "Semantic tokens converted 1:1 from _typography.semantic.scss.",
  "$extensions": {
    "com.jcbrand": {
      "source": "semantic/_typography.semantic.scss",
      "selector": ":root"
    }
  },
  "text": {
    "style": {
      "display": {
        "$type": "fontFamily",
        "$value": "{font.families.sans-1}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--text-style-display"
          }
        }
      },
      "base": {
        "$type": "fontFamily",
        "$value": "{font.families.sans-1}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--text-style-base"
          }
        }
      },
      "decor": {
        "$type": "fontFamily",
        "$value": "{font.families.monospace-1}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--text-style-decor"
          }
        }
      }
    },
    "size": {
      "xxs": {
        "$type": "dimension",
        "$value": "{font.size.100}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--text-size-xxs"
          }
        }
      },
      "xs": {
        "$type": "dimension",
        "$value": "{font.size.200}",
        "$extensions": {
