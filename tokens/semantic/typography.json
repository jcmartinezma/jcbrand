      "lg": {
        "$type": "dimension",
        "$value": "{font.size.500}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--text-size-lg"
          }
        }
      },
      "xl": {
        "$type": "dimension",
        "$value": "{font.size.600}",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--text-size-xl"
