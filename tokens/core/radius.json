{
  "$description": "Core tokens converted 1:1 from _radius.core.scss.",
  "$extensions": {
    "com.jcbrand": {
      "source": "core/_radius.core.scss",
      "selector": ":root"
    }
  },
  "border-radius": {
    "0": {
      "$type": "dimension",
      "$value": "0px",
      "$extensions": {
        "com.jcbrand": {
          "cssVar": "--border-radius-0"
        }
      }
    },
    "100": {
      "$type": "dimension",
      "$value": "4px",
      "$extensions": {
        "com.jcbrand": {
          "cssVar": "--border-radius-100"
        }
      }
    },
    "200": {
      "$type": "dimension",
      "$value": "8px",
      "$extensions": {
        "com.jcbrand": {
          "cssVar": "--border-radius-200"
        }
      }
    },
    "300": {
      "$type": "dimension",
      "$value": "16px",
      "$extensions": {
        "com.jcbrand": {
          "cssVar": "--border-radius-300"
        }
      }
    },
    "400": {
      "$type": "dimension",
      "$value": "32px",
      "$extensions": {
        "com.jcbrand": {
          "cssVar": "--border-radius-400"
        }
      }
    },
    "500": {
      "$type": "dimension",
      "$value": "64px",
      "$extensions": {
        "com.jcbrand": {
          "cssVar": "--border-radius-500"
        }
      }
    },
    "600": {
      "$type": "dimension",
      "$value": "400px",
      "$extensions": {
        "com.jcbrand": {
          "cssVar": "--border-radius-600"
        }
      }
    }
  }
}
