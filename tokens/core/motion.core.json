{
  "$schema": "../../schemas/dtcg-format.2025.10.json",
  "motion": {
    "$description": "Primitive motion values",
    "duration": {
      "$description": "Durations",
      "$type": "duration",
      "0": { "$value": "0s" },
      "100": { "$value": "0.1s" },
      "200": { "$value": "0.15s" },
      "300": { "$value": "0.2s" },
      "400": { "$value": "0.3s" },
      "500": { "$value": "0.4s" },
      "600": { "$value": "0.6s" }
    },
    "delay": {
      "$description": "Delays",
      "$type": "duration",
      "0": { "$value": "0s" },
      "100": { "$value": "0.05s" },
      "200": { "$value": "0.1s" },
      "300": { "$value": "0.15s" }
    },
    "easing": {
      "$description": "Easing curves",
      "$type": "cubicBezier",
      "0": { "$value": [0, 0.0009, 1, 1] },
      "100": { "$value": [0.2, 0, 0, 1] },
      "200": { "$value": [0, 0, 0.2, 1] },
      "300": { "$value": [0.4, 0, 1, 1] }
    }
  }
}
