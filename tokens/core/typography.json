    "weights": {
      "100": {
        "$type": "fontWeight",
        "$value": 300,
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--font-weights-100"
          }
        }
      },
      "200": {
        "$type": "fontWeight",
        "$value": 400,
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--font-weights-200"
          }
        }
      },
      "300": {
        "$type": "fontWeight",
        "$value": 500,
        "$extensions": {
          "com.jcbrand": {
