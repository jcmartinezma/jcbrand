{
  "$description": "Core tokens converted 1:1 from _typography.core.scss.",
  "$extensions": {
    "com.jcbrand": {
      "source": "core/_typography.core.scss",
      "selector": ":root"
    }
  },
  "font": {
    "families": {
      "sans-1": {
        "$type": "fontFamily",
        "$value": [
          "Rethink Sans",
          "sans-serif"
        ],
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--font-families-sans-1"
          }
        }
      },
      "monospace-1": {
        "$type": "fontFamily",
        "$value": [
          "IBM Plex Mono",
          "monospace"
        ],
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--font-families-monospace-1"
          }
        }
      }
    },
    "size": {
      "100": {
        "$type": "dimension",
        "$value": "12px",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--font-size-100"
          }
        }
      },
      "200": {
        "$type": "dimension",
        "$value": "14px",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--font-size-200"
          }
        }
      },
      "300": {
        "$type": "dimension",
        "$value": "16px",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--font-size-300"
          }
        }
      },
      "400": {
        "$type": "dimension",
        "$value": "20px",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--font-size-400"
          }
        }
      },
      "500": {
        "$type": "dimension",
        "$value": "24px",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--font-size-500"
          }
        }
      },
      "600": {
        "$type": "dimension",
        "$value": "32px",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--font-size-600"
          }
        }
      },
      "700": {
        "$type": "dimension",
        "$value": "40px",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--font-size-700"
          }
        }
      },
      "800": {
        "$type": "dimension",
        "$value": "64px",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--font-size-800"
