    "letter-spacings": {
      "minus-100": {
        "$type": "dimension",
        "$value": "-1px",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--font-letter-spacings-minus-100"
          }
        }
      },
      "100": {
        "$type": "dimension",
        "$value": "0px",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--font-letter-spacings-100"
          }
        }
      },
      "200": {
        "$type": "dimension",
        "$value": "1px",
        "$extensions": {
          "com.jcbrand": {
            "cssVar": "--font-letter-spacings-200"
          }
        }
